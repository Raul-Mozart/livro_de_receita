# Porta do servidor do assistente
PORT=3001

# Chave do provedor de IA (fica só no servidor, nunca no app)
# Use uma das duas; se as duas existirem, o Gemini é usado (ou defina AI_PROVIDER)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=

# Token do app: o mesmo valor vai em assets/config/app.env (ASSISTANT_APP_TOKEN)
# Gere um valor aleatório, por exemplo: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ASSISTANT_APP_TOKEN=

# Limites de uso (opcionais)
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_PER_DAY=300
AI_DAILY_LIMIT=2000

# Atrás de proxy/hospedagem (Render, Railway, nginx...), use TRUST_PROXY=1
TRUST_PROXY=

# Opcional: forçar provedor (gemini | openai), modelos e tempo máximo de espera (ms)
AI_PROVIDER=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_MODEL=gpt-4o-mini
PROVIDER_TIMEOUT_MS=7000
