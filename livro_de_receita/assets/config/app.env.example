# Copie este arquivo para "app.env" (na mesma pasta) e preencha.
# Sem o app.env o assistente funciona só no modo local (sem IA).

# URL do backend do assistente
# - Emulador Android: http://10.0.2.2:3001/api/assistant/interpret
# - Celular físico: use o IP do computador na rede (ex.: http://192.168.0.10:3001/...)
# - Produção: use HTTPS
ASSISTANT_BACKEND_URL=http://10.0.2.2:3001/api/assistant/interpret

# Mesmo valor de ASSISTANT_APP_TOKEN do backend/.env
ASSISTANT_APP_TOKEN=
